{
  "name": "openclaw-universal-capture",
  "version": "0.8.0",
  "description": "OpenClaw context engine for append-only Markdown conversation capture.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "index.ts",
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "release:check": "npm run check-types && npm test && npm pack --dry-run"
  },
  "keywords": [
    "openclaw",
    "conversation",
    "capture",
    "context-engine"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lastguru-net/openclaw-universal-capture"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openclaw": "2026.11.3",
    "typescript": "^7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "install": {
      "minHostVersion": ">=2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    }
  }
}
