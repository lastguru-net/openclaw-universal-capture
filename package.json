{
  "name": "openclaw-universal-capture",
  "version": "0.2.0",
  "description": "OpenClaw context engine for append-only Markdown conversation capture.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "index.ts",
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "release:check": "npm run check-types && npm test && npm pack --dry-run"
  },
  "keywords": [
    "openclaw",
    "conversation",
    "capture",
    "context-engine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lastguru-net/openclaw-universal-capture"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.31-beta.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "openclaw": "2026.6.1-beta.1",
    "typescript": "^6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.31-beta.4"
    },
    "install": {
      "minHostVersion": ">=2026.5.31-beta.4"
    }
  }
}
